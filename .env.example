# Copy to `.env` for local development. Never commit real values.
# Production values are created and held in the IPF-owned hosting environment.

# --- Core ---
NODE_ENV=development
PORT=3000
# PostgreSQL (Supabase). Runtime queries use the Transaction Pooler (port 6543).
DATABASE_URL=
# Migrations (`pnpm db:migrate`) use the Session Pooler (port 5432) or a direct connection.
MIGRATION_DATABASE_URL=
# Generate a fresh random value per environment (e.g. `openssl rand -base64 48`).
JWT_SECRET=

# --- Deployment identity ---
# Public origin (scheme + host, no path) used for emailed links and browser-origin checks.
APP_ORIGIN=
# Further accepted production origins, comma-separated (e.g. the www host).
APP_ALTERNATE_ORIGINS=
# Email address of the permanent Super Admin.
OWNER_ADMIN_EMAIL=
# Off Manus: shared secret the host's scheduler sends as `Authorization: Bearer <secret>` to /api/scheduled/*.
# On Manus, scheduled tasks authenticate through the platform and this can stay empty.
CRON_SECRET=

# --- Manus platform (v0.1 host): admin sign-in (OAuth). Replaced when hosting moves off Manus. ---
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
# Manus openId of the Super Admin.
OWNER_OPEN_ID=

# --- Manus platform (v0.1 host): file storage, AI, maps. Replaced when hosting moves off Manus. ---
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# --- Email ---
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# --- Google Workspace (Calendar, mailbox fallback and reply sync) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
JUMP_GMAIL_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- Payments ---
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# --- Analytics (optional) ---
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# --- Opt-in database contract tests (`pnpm test:db`): a disposable PostgreSQL database, session/direct connection ---
TEST_DATABASE_URL=

# --- Opt-in live integration tests (set to 1 only with real credentials) ---
VALIDATE_RESEND_CREDENTIALS=
VALIDATE_RESEND_SENDER=
VALIDATE_GOOGLE_CALENDAR=
